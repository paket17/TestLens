<UserControl x:Class="TestLens.Vsix.ToolWindows.TestLensToolWindowControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vsshell="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="850"
             Background="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBackgroundKey}}"
             Foreground="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Selectable Text Style (looks like TextBlock, allows mouse selection & Ctrl+C) -->
        <Style x:Key="SelectableText" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Cursor" Value="IBeam"/>
            <Setter Property="SelectionBrush" Value="#403b82f6"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Flat VS-styled Button -->
        <Style x:Key="VsFlatButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource {x:Static vsshell:VsBrushes.CommandBarGradientBeginKey}}"/>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static vsshell:VsBrushes.CommandBarBorderKey}}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="7,3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource {x:Static vsshell:VsBrushes.CommandBarHoverKey}}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource {x:Static vsshell:VsBrushes.CommandBarSelectedBorderKey}}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource {x:Static vsshell:VsBrushes.CommandBarSelectedKey}}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Stepper Icon Button Style -->
        <Style x:Key="VsStepperIconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource {x:Static vsshell:VsBrushes.CommandBarHoverKey}}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource {x:Static vsshell:VsBrushes.CommandBarSelectedKey}}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Stepper Value Box Border Style -->
        <Style x:Key="DepthValueBoxBorder" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static vsshell:VsBrushes.SearchBoxBorderKey}}"/>
            <Setter Property="Background" Value="{DynamicResource {x:Static vsshell:VsBrushes.SearchBoxBackgroundKey}}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Margin" Value="2,0"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="#3882f6"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static vsshell:VsBrushes.SearchBoxMouseOverBorderKey}}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Primary Accent Button -->
        <Style x:Key="VsPrimaryButton" TargetType="Button" BasedOn="{StaticResource VsFlatButton}">
            <Setter Property="Background" Value="#2563eb"/>
            <Setter Property="Foreground" Value="#ffffff"/>
            <Setter Property="BorderBrush" Value="#1d4ed8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TOP PANEL: TARGET METHOD & ACTIONS ON LEFT, STATUS BADGE ON RIGHT -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: ACTION BUTTONS AND METHOD INFO -->
            <Border Grid.Column="0" BorderBrush="{DynamicResource {x:Static vsshell:VsBrushes.ComboBoxBorderKey}}" 
                    BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,0,8,0"
                    Background="{DynamicResource {x:Static vsshell:VsBrushes.ComboBoxBackgroundKey}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Buttons and Depth input shifted to the LEFT -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,6">
                        <Button x:Name="BtnRunAll" 
                                Content="{Binding RunAllButtonText, FallbackValue='▶ Run All'}" 
                                ToolTip="{Binding RunAllButtonToolTip, FallbackValue='Run all covering tests'}"
                                IsEnabled="{Binding IsRunAllEnabled, FallbackValue=True}"
                                Click="BtnRunAll_Click" 
                                Style="{StaticResource VsPrimaryButton}" Padding="10,3" Margin="0,0,6,0"/>
                        <Button x:Name="BtnRefresh" Content="{Binding RefreshButtonText, FallbackValue='🔄 Refresh'}" 
                                ToolTip="{Binding RefreshButtonToolTip, FallbackValue='Refresh covering tests'}"
                                Click="BtnRefresh_Click" 
                                Style="{StaticResource VsFlatButton}" Padding="8,3" Margin="0,0,8,0"/>

                        <!-- Modern Search Depth Stepper -->
                        <Border BorderBrush="{DynamicResource {x:Static vsshell:VsBrushes.CommandBarBorderKey}}"
                                BorderThickness="1" CornerRadius="4" 
                                Background="{DynamicResource {x:Static vsshell:VsBrushes.CommandBarGradientBeginKey}}"
                                Padding="2" VerticalAlignment="Center" Margin="0,0,8,0"
                                PreviewMouseWheel="DepthStepper_PreviewMouseWheel"
                                ToolTip="Maximum call chain search depth (1-50, default: 10). Use − / + or scroll wheel to adjust.">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Depth:" FontSize="11" FontWeight="SemiBold" Opacity="0.8" 
                                           Margin="5,0,4,0" VerticalAlignment="Center"
                                           Foreground="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}"/>

                                <!-- Decrement button (−) -->
                                <Button x:Name="BtnDepthDown" Style="{StaticResource VsStepperIconButton}"
                                        Click="BtnDepthDown_Click" ToolTip="Decrease search depth (−1)">
                                    <Path Data="M 3 6 L 9 6" Width="12" Height="12" Stretch="None"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" 
                                          StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Button>

                                <!-- Editable numeric value box -->
                                <Border Style="{StaticResource DepthValueBoxBorder}">
                                    <TextBox x:Name="TbDepth" Text="{Binding SearchDepth, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                             Width="26" Height="18" FontSize="11" FontWeight="Bold" TextAlignment="Center"
                                             VerticalContentAlignment="Center" BorderThickness="0" Background="Transparent"
                                             Foreground="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}"
                                             CaretBrush="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}"
                                             SelectionBrush="#403882f6"
                                             ToolTip="Maximum call chain search depth (1-50, default: 10)"
                                             PreviewTextInput="TbDepth_PreviewTextInput"
                                             KeyDown="TbDepth_KeyDown"/>
                                </Border>

                                <!-- Increment button (+) -->
                                <Button x:Name="BtnDepthUp" Style="{StaticResource VsStepperIconButton}"
                                        Click="BtnDepthUp_Click" ToolTip="Increase search depth (+1)">
                                    <Path Data="M 6 3 L 6 9 M 3 6 L 9 6" Width="12" Height="12" Stretch="None"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" 
                                          StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Target method name -->
                    <TextBox Grid.Row="1" Text="{Binding TargetMethodFqn, Mode=OneWay, FallbackValue='Select a method in code'}" 
                             Style="{StaticResource SelectableText}"
                             FontSize="12" FontWeight="Bold" Margin="0,0,0,2"
                             ToolTip="{Binding TargetMethodFqn}"/>

                    <!-- Target location -->
                    <TextBox Grid.Row="2" Text="{Binding TargetLocation, Mode=OneWay, FallbackValue=''}" 
                             Style="{StaticResource SelectableText}"
                             FontSize="11" Opacity="0.65"
                             ToolTip="{Binding TargetLocation}"/>
                </Grid>
            </Border>

            <!-- RIGHT: STATUS BADGE (Fixed height, narrower, neutral when undetermined) -->
            <Border Grid.Column="1" CornerRadius="4" Padding="12,8"
                    MinWidth="180" MaxWidth="320" MinHeight="68"
                    BorderThickness="1"
                    BorderBrush="{Binding StatusBadgeBorderBrush}"
                    Background="{Binding StatusBadgeBackground}">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="4"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" VerticalAlignment="Center">
                        <TextBlock Text="Status:" FontSize="10" Opacity="0.7" Margin="0,0,0,2"
                                   Foreground="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}"/>
                        <TextBlock Text="{Binding StatusText}" FontWeight="Bold" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{Binding StatusTextColor}"/>
                    </StackPanel>

                    <!-- Progress bar in a fixed 4px row so height never jumps -->
                    <ProgressBar Grid.Row="1" IsIndeterminate="True" Height="3" VerticalAlignment="Center"
                                 Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>
                </Grid>
            </Border>
        </Grid>

        <!-- TESTS LIST / TREEVIEW & EMPTY STATE -->
        <Grid Grid.Row="1">
            <TreeView ItemsSource="{Binding Tests}" 
                      MouseDoubleClick="TreeView_MouseDoubleClick"
                      PreviewMouseWheel="TreeView_PreviewMouseWheel"
                      Background="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBackgroundKey}}"
                      Foreground="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}"
                      BorderBrush="{DynamicResource {x:Static vsshell:VsBrushes.ComboBoxBorderKey}}"
                      BorderThickness="1">

            <!-- System color overrides to prevent double-click / selection whiteout in dark theme -->
            <TreeView.Resources>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#253b82f6"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#ffffff"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#183b82f6"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#ffffff"/>

                <Style TargetType="TreeViewItem">
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Padding" Value="2"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#253b82f6"/>
                            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#0cffffff"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </TreeView.Resources>

            <TreeView.ItemTemplate>
                <HierarchicalDataTemplate ItemsSource="{Binding Chains}">
                    <!-- Test Item Row: Buttons placed on the LEFT of the test name -->
                    <Border Padding="6,4" Margin="0,2">
                        <Border.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Copy Test Name" Click="MenuCopyTestName_Click"/>
                                <MenuItem Header="Copy Fully Qualified Name" Click="MenuCopyTestFqn_Click"/>
                                <MenuItem Header="Copy File Path" Click="MenuCopyTestFilePath_Click"/>
                            </ContextMenu>
                        </Border.ContextMenu>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- 1. Run button on the left -->
                            <Button Grid.Column="0" 
                                    Content="{Binding RunButtonText, FallbackValue='▶ Run'}" 
                                    ToolTip="{Binding RunButtonToolTip, FallbackValue='Run this test'}"
                                    IsEnabled="{Binding IsRunButtonEnabled, FallbackValue=True}"
                                    Click="BtnRunSingleTest_Click" 
                                    Style="{StaticResource VsFlatButton}" Padding="7,2" Margin="0,0,4,0" 
                                    FontWeight="SemiBold" FontSize="11"/>

                            <!-- 2. Go to code button on the left -->
                            <Button Grid.Column="1" Content="Go to code" Click="BtnNavigateTest_Click" 
                                    Style="{StaticResource VsFlatButton}" Padding="7,2" Margin="0,0,8,0" FontSize="11"/>

                            <!-- 3. Status Icon -->
                            <TextBlock Grid.Column="2" Text="{Binding StatusIcon}" Margin="0,0,6,0" FontSize="13" 
                                       VerticalAlignment="Center"/>

                            <!-- 4. Test Name + Framework + Depth (Selectable & Ellipsis) -->
                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBox Text="{Binding DisplayName, Mode=OneWay}" FontWeight="Bold" 
                                         Style="{StaticResource SelectableText}"
                                         ToolTip="{Binding FullyQualifiedName}"/>
                                <Border Background="#203b82f6" CornerRadius="3" Padding="4,1" Margin="8,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Framework}" FontSize="10" Foreground="#2563eb"/>
                                </Border>
                                <TextBlock Text="{Binding DepthText}" FontSize="11" Opacity="0.7" VerticalAlignment="Center"
                                           Foreground="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}"/>
                            </StackPanel>

                            <!-- 5. Test Run Status Badge (Passed / Failed) -->
                            <TextBlock Grid.Column="4" Text="{Binding StatusBadgeText}" FontWeight="SemiBold" 
                                       Foreground="{Binding StatusColor}" FontSize="11" Margin="8,0,4,0" 
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Chain Item Template -->
                    <HierarchicalDataTemplate.ItemTemplate>
                        <HierarchicalDataTemplate ItemsSource="{Binding Steps}">
                            <TextBlock Text="└─ Call chain:" FontStyle="Italic" Opacity="0.7" Margin="0,2"
                                       Foreground="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}"/>

                            <!-- Step Item Template -->
                            <HierarchicalDataTemplate.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="4,2">
                                        <Border.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Copy Step Call" Click="MenuCopyStepCall_Click"/>
                                                <MenuItem Header="Copy Location" Click="MenuCopyStepLocation_Click"/>
                                            </ContextMenu>
                                        </Border.ContextMenu>

                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="├─ " Opacity="0.4" FontFamily="Consolas"
                                                       Foreground="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}"/>
                                            <TextBox Text="{Binding CallerName, Mode=OneWay}" FontWeight="SemiBold"
                                                     Style="{StaticResource SelectableText}" ToolTip="{Binding CallerName}"/>
                                            <TextBlock Text=" ➔ " Opacity="0.6"
                                                       Foreground="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}"/>
                                            <TextBox Text="{Binding CalleeName, Mode=OneWay}"
                                                     Style="{StaticResource SelectableText}" ToolTip="{Binding CalleeName}"/>
                                            <TextBlock Text="{Binding StepKind}" Foreground="#d97706" Margin="6,0"/>
                                            <TextBox Text="{Binding Location, Mode=OneWay}" Opacity="0.65" Margin="8,0" 
                                                     FontFamily="Consolas" FontSize="10"
                                                     Style="{StaticResource SelectableText}" ToolTip="{Binding Location}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </HierarchicalDataTemplate.ItemTemplate>
                        </HierarchicalDataTemplate>
                    </HierarchicalDataTemplate.ItemTemplate>
                </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>

        <!-- EMPTY STATE WHEN NOT COVERED -->
        <Border HorizontalAlignment="Center" VerticalAlignment="Center" 
                Visibility="{Binding IsEmptyNotCovered, Converter={StaticResource BoolToVis}}"
                Background="Transparent" IsHitTestVisible="False" Padding="20">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="🔍 No covering tests found" FontSize="13" FontWeight="SemiBold" 
                           HorizontalAlignment="Center" Margin="0,0,0,6"
                           Foreground="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}" Opacity="0.85"/>
                <TextBlock Text="No tests reached this method within the current call depth limit." 
                           FontSize="11" HorizontalAlignment="Center" Margin="0,0,0,6"
                           Foreground="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}" Opacity="0.6"/>
                <TextBlock Text="💡 Try increasing 'Depth' in the toolbar and click '🔄 Refresh'." 
                           FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center"
                           Foreground="#3882f6"/>
            </StackPanel>
        </Border>
    </Grid>

        <!-- FOOTER BAR -->
        <StatusBar Grid.Row="2" Margin="0,5,0,0" Background="Transparent">
            <StatusBarItem>
                <TextBox Text="{Binding ElapsedTimeText, Mode=OneWay}" FontSize="11"
                         Style="{StaticResource SelectableText}"
                         Foreground="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="TestLens (Roslyn Call Graph)" FontSize="11" Opacity="0.65"
                           Foreground="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</UserControl>
