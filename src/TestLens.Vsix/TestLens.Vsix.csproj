<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <UseWpf>true</UseWpf>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <GeneratePkgDefFile>true</GeneratePkgDefFile>
    <IncludeAssemblyInVSIXContainer>true</IncludeAssemblyInVSIXContainer>
    <IncludeDebugSymbolsInVSIXContainer>true</IncludeDebugSymbolsInVSIXContainer>
    <IncludeDebugSymbolsInLocalVSIXDeployment>false</IncludeDebugSymbolsInLocalVSIXDeployment>
    <CopyBuildOutputToOutputDirectory>true</CopyBuildOutputToOutputDirectory>
    <CopyOutputSymbolsToOutputDirectory>true</CopyOutputSymbolsToOutputDirectory>
    <CreateVsixContainer>true</CreateVsixContainer>
    <TargetVsixContainerName>TestLens.vsix</TargetVsixContainerName>
    <DeployVSTemplates>false</DeployVSTemplates>
    <UseCodebase>true</UseCodebase>
    <CreatePkgDefAssemblyToProcess>$(MSBuildProjectDirectory)\bin\$(Configuration)\$(TargetFramework)\TestLens.Vsix.dll</CreatePkgDefAssemblyToProcess>
  </PropertyGroup>

  <PropertyGroup>
    <GeneratePkgDefDependsOn>$(GeneratePkgDefDependsOn);Build</GeneratePkgDefDependsOn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TestLens.Core\TestLens.Core.csproj">
      <SetTargetFramework>TargetFramework=netstandard2.0</SetTargetFramework>
      <IncludeOutputGroupsInVSIX>BuiltProjectOutputGroup%3bBuiltProjectOutputGroupDependencies%3bGetCopyToOutputDirectoryItems%3bSatelliteDllsProjectOutputGroup%3b</IncludeOutputGroupsInVSIX>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Community.VisualStudio.Toolkit.17" Version="17.0.551" />
    <PackageReference Include="Microsoft.VSSDK.BuildTools" Version="17.10.2185" GeneratePathProperty="true" PrivateAssets="all" />
    <PackageReference Include="Microsoft.VisualStudio.LanguageServices" Version="4.10.0" />
    <PackageReference Include="System.Text.Json" Version="8.0.5" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <VSCTCompile Include="VSCommandTable.vsct">
      <ResourceName>Menus.ctmenu</ResourceName>
    </VSCTCompile>
  </ItemGroup>

  <Import Project="$(PkgMicrosoft_VSSDK_BuildTools)\tools\VSSDK\Microsoft.VsSDK.targets" Condition="Exists('$(PkgMicrosoft_VSSDK_BuildTools)\tools\VSSDK\Microsoft.VsSDK.targets')" />



  <Target Name="GenerateTemplatesManifest" />

  <Target Name="CreateVsixAfterBuild" AfterTargets="Build" Condition="'$(CreateVsixContainer)' == 'true'" DependsOnTargets="GeneratePkgDef;CopyPkgDef;CreateVsixContainer" />

</Project>
